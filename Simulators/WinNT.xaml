<Window x:Class="WindowsBootscreenSimulatorPlus.WinNT"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsBootscreenSimulatorPlus"
         Icon="/Resources/logo.png" Cursor="Wait"
        mc:Ignorable="d" WindowStyle="None" Loaded="Window_Loaded"  KeyDown="Window_KeyDown" Background="Black" d:Background="#0000a0"
        Title="Windows NT Bootscreen Simulator" Height="480" Width="640" MouseDoubleClick="Window_MouseDoubleClick"
        MouseRightButtonUp="Window_MouseRightButtonUp">
    <Grid>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Name="GenerateCenterText" Foreground="White" Text="Generating bootscreen..." Visibility="Collapsed"></TextBlock>
        <Viewbox Stretch="Uniform" Name="VBox"
     SnapsToDevicePixels="True"
     UseLayoutRounding="True"
     RenderOptions.EdgeMode="Aliased"
     RenderOptions.BitmapScalingMode="NearestNeighbor">
        <Image Stretch="Fill" Name="RasterImage" Width="640" Height="480"/>
    </Viewbox>
    </Grid>
</Window>

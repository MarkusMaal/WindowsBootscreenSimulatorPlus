<Window x:Class="WindowsBootscreenSimulatorPlus.Simulators.Win1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsBootscreenSimulatorPlus.Simulators"
        mc:Ignorable="d" Background="#0000AA" Foreground="White" Loaded="Window_Loaded"
         MouseDoubleClick="Window_MouseDoubleClick" KeyDown="Window_KeyDown"
        Title="Windows 1.x/2.x bootscreen simulator" Height="400" Width="640"
        MouseRightButtonUp="Window_MouseRightButtonUp">
    <Viewbox d:Stretch="Fill" Name="VBox"
       SnapsToDevicePixels="True"
       UseLayoutRounding="True"
       RenderOptions.EdgeMode="Aliased"
       RenderOptions.BitmapScalingMode="NearestNeighbor">
        <Grid Width="320" Height="100">
            <Image Width="320" Height="18" Name="LogoTest"
               Stretch="Fill"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="0, 17, 0, 0"></Image>
            <Image Name="CenterText" Width="72" Height="8" Margin="0,15,0,0" Stretch="Fill"></Image>
            <Image Name="BottomText" Width="255" Height="8" Stretch="Fill" VerticalAlignment="Bottom"></Image>
        </Grid>
    </Viewbox>
</Window>

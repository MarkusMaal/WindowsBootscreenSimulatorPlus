<Window x:Class="WindowsBootscreenSimulatorPlus.Win98"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsBootscreenSimulatorPlus" Icon="/Resources/logo.png"
        mc:Ignorable="d" WindowStyle="None" Loaded="Window_Loaded" Background="Black" KeyDown="Window_KeyDown"
        Title="9x Bootscreen Simulator" Height="400" Width="640" MouseDoubleClick="Window_MouseDoubleClick"
        MouseRightButtonUp="Window_MouseRightButtonUp">
    <Viewbox Stretch="Uniform" Name="VBox"
       SnapsToDevicePixels="True"
       UseLayoutRounding="True"
       RenderOptions.EdgeMode="Aliased"
       RenderOptions.BitmapScalingMode="NearestNeighbor">
        <Grid Width="640" Height="400">
            <Grid Width="1280">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="640"></ColumnDefinition>
                    <ColumnDefinition Width="640"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Image Grid.Row="0" x:Name="LogoImage" HorizontalAlignment="Left" Height="393" Source="/Resources/Windows-98-4.10.1998-Boot.png" Stretch="UniformToFill" Width="640"/>
                <Image Name="Slit1" Grid.Row="1" Grid.Column="0" Source="/Resources/slit.png" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="7" />
                <Image Name="Slit2" Grid.Row="1" Grid.Column="1" Source="/Resources/slit.png" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="7" />
            </Grid>
        </Grid>
    </Viewbox>
</Window>

<Window x:Class="WindowsBootscreenSimulatorPlus.WinNT"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsBootscreenSimulatorPlus"
         Icon="/Resources/logo.png" Cursor="Wait"
        mc:Ignorable="d" WindowStyle="None" Loaded="Window_Loaded"  KeyDown="Window_KeyDown" Background="Black"
        Title="Windows NT Bootscreen Simulator" Height="480" Width="640" MouseDoubleClick="Window_MouseDoubleClick"
        MouseRightButtonUp="Window_MouseRightButtonUp">
    <Grid>
        <StackPanel Name="GenerateCenter" Orientation="Vertical"  HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Visibility="Collapsed">
            <TextBlock FontSize="20" Name="GenerateCenterText" Foreground="White" Text="Generating bootscreen..."></TextBlock>
            <ProgressBar Name="GenerateCenterBar" Margin="0,15,0,0" Maximum="100" IsIndeterminate="True" Value="0"/>
        </StackPanel>
        <Viewbox Stretch="Uniform" Name="VBox"
     SnapsToDevicePixels="True"
     UseLayoutRounding="True"
     RenderOptions.EdgeMode="Aliased"
     RenderOptions.BitmapScalingMode="NearestNeighbor">
        <Image Stretch="Fill" Name="RasterImage" Width="640" Height="480"/>
    </Viewbox>
    </Grid>
</Window>

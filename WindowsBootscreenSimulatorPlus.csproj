<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	<PublishSingleFile>true</PublishSingleFile>
	<DebugSymbols>false</DebugSymbols>
	<DebugType>None</DebugType>
	<ApplicationIcon>logo.ico</ApplicationIcon>
	<AssemblyVersion>0.16.0.0</AssemblyVersion>
	<FileVersion>0.16.0.0</FileVersion>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageIcon>logo.png</PackageIcon>
	<PackageProjectUrl>https://github.com/MarkusMaal/WindowsBootScreenSimulatorPlus</PackageProjectUrl>
	<Copyright>(c) 2024 - 2026  Markus Maal</Copyright>
	<Description>A tool that lets the user simulate various bootscreens from the Microsoft Windows operating system.</Description>
	<Title>Windows Bootscreen Simulator Plus</Title>
	<RepositoryType>git</RepositoryType>
	<RepositoryUrl>https://github.com/MarkusMaal/WindowsBootScreenSimulatorPlus</RepositoryUrl>
	<AssemblyTitle>Windows Bootscreen Simulator Plus</AssemblyTitle>
	<Company>Markuse tarkvara</Company>

  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\NtChars.txt" />
    <None Remove="Resources\slit.png" />
    <None Remove="Resources\slit2k.png" />
    <None Remove="Resources\slit2kServer.png" />
    <None Remove="Resources\Windows-2000-CopyProgress.png" />
    <None Remove="Resources\Windows-2000-Pro.png" />
    <None Remove="Resources\Windows-2000-Server.png" />
    <None Remove="Resources\Windows-98-4.10.1998-Boot.png" />
    <None Remove="Resources\Windows-XP-SP2-Boot.png" />
    <None Remove="Resources\xp_blue_throbber.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\logo.png" />
    <Resource Include="Resources\NtChars.txt" />
    <Resource Include="Resources\slit.png" />
    <Resource Include="Resources\slit2k.png" />
    <Resource Include="Resources\slit2kServer.png" />
    <Resource Include="Resources\Windows-2000-CopyProgress.png" />
    <Resource Include="Resources\Windows-2000-Pro.png" />
    <Resource Include="Resources\Windows-2000-Server.png" />
    <Resource Include="Resources\Windows-98-4.10.1998-Boot.png" />
    <Resource Include="Resources\Windows-XP-SP2-Boot.png" />
    <Resource Include="Resources\xp_blue_throbber.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="Resources\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
